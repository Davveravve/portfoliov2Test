# ─────────────────────────────────────────────────────────────────────────────
# Devlog portfolio — environment variables
# Nothing here is required for local development: with no variables set, the app
# uses an embedded Postgres (PGlite in .data/pglite) and local file storage
# (.data/uploads). Copy to .env.local and fill in what you need.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute public URL, used for canonical URLs, sitemap, feeds, OG images and
# email links. On Vercel, falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Vercel Postgres). Use the *pooled* URL on
# Vercel. Leave empty to use PGlite (embedded Postgres) in .data/pglite.
DATABASE_URL=
# Optional: where PGlite stores its data when DATABASE_URL is empty.
# Use "memory://" for a throwaway in-memory database.
PGLITE_DATA_DIR=.data/pglite

# ── Media storage ────────────────────────────────────────────────────────────
# "local" (default): files in .data/uploads, served by /media/[...key].
#                    Not persistent on Vercel — use "s3" in production.
# "s3":              any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# Local driver only: directory for uploads.
LOCAL_STORAGE_DIR=.data/uploads
# S3 / R2 driver only. For R2 the endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com and the region is "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket is served from (R2 custom domain or r2.dev URL),
# without a trailing slash, e.g. https://media.example.com
S3_PUBLIC_URL=

# ── Admin auth (Phase 3) — Auth.js v5 with GitHub OAuth ─────────────────────
# Secret used to sign sessions. Generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth app credentials. Callback URL: <SITE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The ONLY GitHub account allowed into /admin: its numeric user id
# (find it at https://api.github.com/users/<your-username>, field "id").
AUTH_GITHUB_ALLOWED_ID=
# Test-only: enables a credentials login for Playwright. Ignored when
# NODE_ENV=production unless running the e2e suite. Never set in production.
AUTH_TEST_MODE=

# ── Email / following (Phase 4) — Resend ───────────────────────────────────
# When RESEND_API_KEY is empty, the "Follow this project" feature is hidden
# and all subscription routes return 404. Nothing crashes.
RESEND_API_KEY=
# Verified sender, e.g. "Devlog <devlog@example.com>"
EMAIL_FROM=

# ── Cron (Phase 4) ──────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/notify,
# which emails subscribers about scheduled posts that just went live.
CRON_SECRET=
